# Un solo dominio por municipalidad; DOMINIO viene de las variables de la instalación
# (por ejemplo, proyectos.muni.go.cr). Con un dominio público, Caddy pide y renueva el
# certificado de Let's Encrypt solo. Con DOMINIO=localhost usa un certificado local, para probar.
{$DOMINIO} {
	encode zstd gzip

	request_body {
		max_size 12MB
	}

	# Fotos subidas (ALMACENAMIENTO_FOTOS=local): las sirve Caddy directo desde el volumen.
	# Django solo deja archivos JPG, PNG o WebP con nombre propio, así que no hay HTML ni SVG.
	handle_path /api/v1/media/* {
		root * /srv/media
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# API de Django.
	@django {
		path /api/*
		not path /api/v1/media/*
	}
	handle @django {
		reverse_proxy api:8000
	}

	# Estáticos de Django, como los de la API navegable (collectstatic deja los archivos en este volumen).
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# Vista previa al compartir un enlace del portal: los robots que la arman no corren JavaScript, así que
	# reciben de Django un HTML corto con Open Graph. Las personas y los buscadores (que sí lo corren)
	# reciben la aplicación de siempre; si Django falla, solo falla la vista previa.
	@vistaPrevia {
		path /publico /publico/ /publico/proyectos/*
		header_regexp User-Agent (?i)(facebookexternalhit|facebookcatalog|meta-externalagent|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|skypeuripreview|redditbot|pinterestbot|embedly|iframely|mastodon|bluesky|signal)
	}
	handle @vistaPrevia {
		rewrite * /api/v1/public/vista-previa{path}
		reverse_proxy api:8000
	}

	# El front: cualquier otra ruta es de la aplicación y sirve index.html.
	handle {
		root * /srv/app
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://res.cloudinary.com; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' {$MAPA_ORIGEN:https://tiles.openfreemap.org} {$BUSQUEDA_ORIGEN:https://nominatim.openstreetmap.org}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}
