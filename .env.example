# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el archivo .env al repositorio

# Django
# Generar con: python -c "from django.core.signing import get_random_string; print(get_random_string(50))"
SECRET_KEY=clave-secreta-de-django-minimo-50-caracteres
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=

# Base de datos MySQL
DB_NAME=MuniManagement
DB_USER=root
DB_PASSWORD=tu-password-de-mysql
DB_HOST=mysql
DB_PORT=3306

# Email (Gmail App Password - NO tu contraseña normal)
# Tutorial: https://support.google.com/accounts/answer/185833
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx

# AWS S3 (IAM > Users > Security credentials > Create access key)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=tu-secret-key-de-40-caracteres
AWS_STORAGE_BUCKET_NAME=nombre-de-tu-bucket
AWS_S3_REGION_NAME=us-east-1

# Frontend Vite
VITE_API_URL=http://localhost:8000
VITE_AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
VITE_AWS_SECRET_ACCESS_KEY=tu-secret-key-de-40-caracteres
VITE_AWS_BUCKET_NAME=nombre-de-tu-bucket
VITE_AWS_REGION=us-east-1
